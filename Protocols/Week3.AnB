Protocol: PhotoBook_W3

Types:
    Agent A, ip, B, P;
    Number NA, NB, NP, Payload;
    Function sk, pk, pw;

Knowledge:
    A: A, ip, B, P, pk(ip), pw(A,ip);
    ip: A, ip, B, P, pk(ip), pw(A,ip), sk(ip,B);
    B: A, ip, B, P, pk(ip), sk(ip,B), sk(B,P);
    P: A, ip, B, P, pk(ip), sk(B,P);

Actions:
    A  -> ip: A, NA, pw(A,ip)
    ip -> B: {| A, NA |}sk(ip,B)
    B  -> P: {| A, NA, NB |}sk(B,P)
    P  -> B: {| NB, NP |}sk(B,P)
    B  -> P: {| NB, NP, Payload |}sk(B,P)

Goals:
    
    B authenticates P on NB,NP;
    P authenticates B on NB, NP, Payload;
    Payload secret between B, P;
