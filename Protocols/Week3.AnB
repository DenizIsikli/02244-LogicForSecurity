Protocol: PhotoBook_W3

Types:
  Agent A, B, P, ip;
  Number NA, NID, Folder;
  Function pk, photos, pw, h;

Knowledge:
  B: A, B, P, ip, pk(B), inv(pk(B)), pk(ip), pk(P), photos;
  A: A, B, P, ip, pk(ip), pk(B), pk(P), pw(A,ip), h;
  P: A, B, P, ip, pk(P), inv(pk(P)), pk(ip), pk(B);
  ip: A, B, P, ip, pk(ip), inv(pk(ip)), pk(B), pk(P), pw(A,ip), h;

Actions:
  A -> ip: A, P, B, Folder, NA
  ip -> A: NID
  A -> ip: h(pw(A,ip), NID, NA)
  ip -> P: {ip, A, P, B, Folder, NA}inv(pk(ip))
  P -> B: {{ip, A, P, B, Folder, NA}inv(pk(ip))}pk(B)
  B -> P: {{B, photos(Folder, NA), NA}inv(pk(B))}pk(P)

Goals:
  B  authenticates ip on A, P, Folder, NA;
  P  authenticates ip on A, B, Folder, NA;
  P  authenticates B on photos(Folder, NA);
