Protocol: PhotoBook_W3

Types:
  Agent A, IP, B, P;
  Number NA, NB, NP, Payload;
  Function sk, pw;

Knowledge:
  A: A, IP, B, P, pw(A,IP); # Without pw(A,IP) it completes in 2 minutes max
  IP: A, IP, B, P, pw(A,IP), sk(IP,B);
  B: A, IP, B, P, sk(IP,B), sk(B,P);
  P: A, IP, B, P, sk(B,P);

Actions:
  A  -> IP: A, NA, pw(A,IP)
  IP -> B: {|A,NA|}sk(IP,B)
  B  -> P: {|A,NA,NB|}sk(B,P)
  P  -> B: {|NB,NP|}sk(B,P)
  B  -> P: {|NB,NP,Payload|}sk(B,P)

Goals:
  P authenticates B on NB,NP;
  Payload secret between B,P;
