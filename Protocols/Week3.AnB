Protocol: PhotoBook_W3

Types:
  Agent A, IP, B, P;
  Number NA, NID, NB, NP, Payload;
  Function sk, pw;

Knowledge:
  A: A, IP, B, P, pw(A,IP);
  IP: A, IP, B, P, sk(IP,B), pw(A,IP);
  B: A, IP, B, P, sk(IP,B), sk(B,P);
  P: A, IP, B, P, sk(B,P);

Actions:
  A  -> IP: A, B, P, NA, pw(A,IP)
  IP -> B:  {| A, P, NA, NID |}sk(IP,B)
  B  -> P:  {| A, NA, NID, NB |}sk(B,P)
  P  -> B:  NP
  B  -> P:  {| NB, NP, Payload |}sk(B,P)

Goals:
  B authenticates IP on A, P, NA, NID;
  P authenticates B on NB, NP;
  Payload secret between B, P;
