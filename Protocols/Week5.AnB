Protocol: PhotoBook_W5

Types:
  Agent A, B, P, ip;
  Number NA, NID, NB;
  Text Folder;
  Function photos, h;
  Const pwA;

Knowledge:
  A:  A, B, P, ip, pwA(A,ip), h;
  B:  A, B, P, ip, photos;
  P:  A, B, P, ip;
  ip: A, B, P, ip, pwA(A,ip), h;

Actions:
  A  *-> ip: A,P,B,Folder,NA
  ip ->* A: NID
  A  *-> ip: A,NID,h(pwA(A,ip),NID,NA)
  ip ->* P: ip,A,P,B,Folder,NA
  P  ->* B: P,B,Folder,NA,NB
  B  ->* P: B,P,Folder,NA,NB,photos(Folder,NA)

Goals:
  P authenticates B on NB,photos(Folder,NA);
