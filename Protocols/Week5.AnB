Protocol: PhotoBook_W5

Types:
    Agent a, B, p, ip;
    Number NA, NID, NB, Payload;
    Function h;
    Const pwA;

Knowledge:
    a:  a, B, p, ip, pwA(a,ip), h;
    B:  a, B, p, ip;
    p:  a, B, p, ip;
    ip: a, B, p, ip, pwA(a,ip), h;

Actions:
    a  *-> ip: a,p,B,NA
    ip ->* a: NID
    a  *-> ip: a,NID,h(pwA(a,ip),NID,NA)
    ip ->* p: ip,a,p,B,NA
    p  ->* B: p,B,NA,NB
    B  ->* p: B,p,NA,NB,Payload

Goals:
    p authenticates B on NB,Payload;
    Payload secret between B,p;
