Protocol: PhotoBook_W4

Types:
    Agent a, ip, B, p;
    Number NA, NB, NP, Payload;
    Function sk, pw, pk;
    Format f0, f1, f2, f3, f4, f5, f6;

Knowledge:
    a:  a, ip, B, p, pw(a,ip), pk(ip), f0, f1, f2;
    ip: a, ip, B, p, pw(a,ip), pk(ip), pk(B), sk(ip,B), f0, f1, f2, f3;
    B:  a, ip, B, p, sk(ip,B), sk(B,p), f3, f4;
    p:  a, ip, B, p, sk(B,p), f4, f5, f6;

Actions:
    a  -> ip: f0(a,B)
    ip -> a:  f1(B,pk(B))
    a  -> ip: f2(a,NA,pw(a,ip))
    ip -> B:  {|f3(a,NA)|}sk(ip,B)
    B  -> p:  {|f4(a,NA,NB)|}sk(B,p)
    p  -> B:  {|f5(NB,NP)|}sk(B,p)
    B  -> p:  {|f6(NB,NP,Payload)|}sk(B,p)

Goals:
    p authenticates B on NB,NP;
    Payload secret between B,p;
