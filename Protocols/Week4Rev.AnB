Protocol: PhotoBook_W4_main

Types:
  Agent A, B, P, ip;
  Number NA, NB;
  Text Folder;
  Function pk, photos, h;
  Format f1, f2, f3, f4, f5;

Knowledge:
  A:  A, B, P, ip, pk(ip), pk(B), pk(P), pwA(A,ip), h;
  B:  A, B, P, ip, pk(B), inv(pk(B)), pk(ip), pk(P), photos;
  P:  A, B, P, ip, pk(P), inv(pk(P)), pk(ip), pk(B);
  ip: A, B, P, ip, pk(ip), inv(pk(ip)), pk(B), pk(P), pwA(A,ip), h;

Actions:
  A  -> ip: f1(A,P,B,Folder,NA)
  ip -> A:  {{f2(ip,A,P,B,Folder,NA)}inv(pk(ip))}pk(P)
  A  -> P:  {{f2(ip,A,P,B,Folder,NA)}inv(pk(ip))}pk(P)
  P  -> B:  f3(P,A,Folder)
  B  -> P:  {f4(B,NB)}pk(P)
  P  -> B:  {{f2(ip,A,P,B,Folder,NA)}inv(pk(ip)), f4(B,NB)}pk(B)
  B  -> P:  {{f5(B,P,photos(Folder,NA),NB)}inv(pk(B))}pk(P)

Goals:
  B authenticates ip on A,P,Folder,NA;
  P authenticates ip on A,B,Folder,NA;
  P authenticates B on photos(Folder,NA);
