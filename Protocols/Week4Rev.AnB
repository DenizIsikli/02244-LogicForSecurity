Protocol: PhotoBook_W4

Types:
  Agent A, IP, B, P;
  Number NA, NB, NP, Payload;
  Function sk, pw, pk;
  Format f1, f2, f3, f4, f5;

Knowledge:
  A:  A, IP, B, P, pw(A,IP), pk(IP);
  IP: A, IP, B, P, pw(A,IP), sk(IP,B), pk(IP), inv(pk(IP));
  B:  A, IP, B, P, sk(IP,B), sk(B,P);
  P:  A, IP, B, P, sk(B,P);

Actions:
  A  -> IP: f1(A,NA,pw(A,IP))
  IP -> B:  {|f2(A,NA)|}sk(IP,B)
  B  -> P:  {|f3(A,NA,NB)|}sk(B,P)
  P  -> B:  {|f4(NB,NP)|}sk(B,P)
  B  -> P:  {|f5(NB,NP,Payload)|}sk(B,P)

Goals:
  P authenticates B on NB,NP;
  Payload secret between B,P;
